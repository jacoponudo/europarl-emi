# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.DS_Store

# Dati e modelli: fuori da git (pesanti, corpus non pubblico)
data/**
!data/**/
!**/.gitkeep
!data/raw/lexicons/*.csv
models/**
!models/.gitkeep
results/figures/legacy/*
!results/figures/legacy/.gitkeep
paper/

# Output: si rigenerano con la pipeline o con gli script di review, non vanno in git
results/**
!results/**/
!**/.gitkeep
notebooks/**/*.csv
notebooks/**/*.pdf
notebooks/**/*.png
notebooks/**/*.tex
notebooks/**/*.parquet
notebooks/review/*.ipynb
*.log
