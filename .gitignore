# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.DS_Store

# Data: outside git (large files, corpus not public)
data/**
!data/**/
!**/.gitkeep
!data/raw/lexicons/*.csv
/paper/
models/

# Outputs: regenerated by the scripts, not in git
results/**
!results/**/
!**/.gitkeep
notebooks/**/*.csv
notebooks/**/*.pdf
notebooks/**/*.png
notebooks/**/*.tex
notebooks/**/*.parquet
notebooks/review/*.ipynb
*.log
